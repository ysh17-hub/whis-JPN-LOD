# 世界かんがい施設遺産（日本）LOD のサンプル SPARQL
# ローカルでは run_queries.py（rdflib）で動作確認済み。
# Q4 は Wikidata の SPARQL エンドポイント（https://query.wikidata.org/）で実行する「つなげ方」の例。

PREFIX whis:   <https://ysh17-hub.github.io/whis-lod/ontology#>
PREFIX schema: <https://schema.org/>
PREFIX geo:    <http://www.opengis.net/ont/geosparql#>
PREFIX wgs:    <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>

# --- Q1: 都道府県ごとの登録数（多い順） ---
SELECT ?pref (COUNT(?s) AS ?n) WHERE {
  ?s a whis:HeritageIrrigationStructure ;
     schema:addressRegion ?pref .
} GROUP BY ?pref ORDER BY DESC(?n)

