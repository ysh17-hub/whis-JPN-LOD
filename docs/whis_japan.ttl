@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res: <https://ysh17-hub.github.io/whis-lod/resource/> .
@prefix schema: <https://schema.org/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix wgs84: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix whis: <https://ysh17-hub.github.io/whis-lod/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

whis:builtYear a rdf:Property ;
    rdfs:label "year built"@en,
        "建設年（何の年かは builtYearBasis に記載）"@ja ;
    rdfs:range xsd:gYear .

whis:builtYearBasis a rdf:Property ;
    rdfs:label "basis of built year"@en,
        "建設年の根拠（着工・完成・供用開始など）"@ja ;
    rdfs:range xsd:string .

whis:facilityType a rdf:Property ;
    rdfs:label "facility type"@en,
        "施設の種類"@ja ;
    rdfs:range xsd:string .

whis:irrigatedArea a rdf:Property ;
    rdfs:label "irrigated area (ha)"@en,
        "かんがい面積（ha）"@ja ;
    rdfs:range xsd:decimal .

whis:managedBy a rdf:Property ;
    rdfs:label "managing organization"@en,
        "管理者"@ja ;
    rdfs:range xsd:string .

whis:pointAddress a rdf:Property ;
    rdfs:label "address of the representative point (reverse-geocoded by GSI)"@en,
        "代表地点の住所（国土地理院の逆ジオコーダで座標から求めた市区町村・大字）"@ja ;
    rdfs:range xsd:string .

whis:prefectureCode a rdf:Property ;
    rdfs:label "prefecture code"@en,
        "都道府県コード（ISO 3166-2:JP）"@ja ;
    rdfs:range xsd:string .

whis:registeredYear a rdf:Property ;
    rdfs:label "year of registration"@en,
        "登録年"@ja ;
    rdfs:range xsd:gYear .

whis:representativePoint a rdf:Property ;
    rdfs:label "representative point name"@en,
        "代表地点（座標を取る場所の名前）"@ja ;
    rdfs:range xsd:string .

whis:waterSource a rdf:Property ;
    rdfs:label "water source (river, lake, etc.)"@en,
        "水源（川・湖など。Wikidataにあれば IRI）"@ja .

whis:waterSourceName a rdf:Property ;
    rdfs:label "name of the water source as written in the sources"@en,
        "水源の名前（資料の表記）"@ja .

