@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix whis: <https://ysh17-hub.github.io/whis-lod/ontology#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

whis:dimension-provenance a dqv:Dimension ;
    skos:prefLabel "来歴"@ja .

whis:metric-address-link-coverage a dqv:Metric ;
    skos:definition "住所LODの IRI がある施設の数÷施設の数"@ja ;
    skos:prefLabel "住所LODにつないだ代表地点の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-linkability .

whis:metric-completeness-built_year a dqv:Metric ;
    skos:definition "建設年の値がある施設の数÷施設の数（空欄は不明の意味）"@ja ;
    skos:prefLabel "建設年がある施設の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-completeness .

whis:metric-completeness-built_year_or_period a dqv:Metric ;
    skos:definition "建設年か、建設時期（資料の表現。年に換算しない）の値がある施設の数÷施設の数"@ja ;
    skos:prefLabel "建設年または建設時期がある施設の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-completeness .

whis:metric-completeness-irrigated_area_ha a dqv:Metric ;
    skos:definition "かんがい面積の値がある施設の数÷施設の数（空欄は不明の意味）"@ja ;
    skos:prefLabel "かんがい面積がある施設の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-completeness .

whis:metric-completeness-lat a dqv:Metric ;
    skos:definition "座標の値がある施設の数÷施設の数（空欄は不明の意味）"@ja ;
    skos:prefLabel "座標がある施設の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-completeness .

whis:metric-completeness-managing_org a dqv:Metric ;
    skos:definition "管理者の値がある施設の数÷施設の数（空欄は不明の意味）"@ja ;
    skos:prefLabel "管理者がある施設の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-completeness .

whis:metric-completeness-name_en a dqv:Metric ;
    skos:definition "英語名の値がある施設の数÷施設の数（空欄は不明の意味）"@ja ;
    skos:prefLabel "英語名がある施設の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-completeness .

whis:metric-elevation-agreement a dqv:Metric ;
    skos:definition "国土地理院の標高APIの値（同じ単位に丸める）と、使った標高モデルの種類が一致した地点の数÷照合した地点の数"@ja ;
    skos:prefLabel "標高が国土地理院の標高表示と一致した割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-accuracy .

whis:metric-link-health a dqv:Metric ;
    skos:definition "毎月のリンク健康診断で開けたURLの数÷確かめたURLの数"@ja ;
    skos:prefLabel "開けたリンクの割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-accuracy .

whis:metric-source-coverage a dqv:Metric ;
    skos:definition "出典URLが1つ以上ある施設の数÷施設の数"@ja ;
    skos:prefLabel "出典のある施設の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-provenance .

whis:metric-wikidata-point-agreement a dqv:Metric ;
    skos:definition "ため池・堰・揚水機場で、Wikidata の座標（P625）から1km以内にある施設の数÷比べた施設の数"@ja ;
    skos:prefLabel "点の施設の座標が Wikidata と1km以内の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-accuracy .

whis:metric-wikidata-same-coverage a dqv:Metric ;
    skos:definition "owl:sameAs がある施設の数÷施設の数"@ja ;
    skos:prefLabel "Wikidata と「同じ施設」でつないだ施設の割合"@ja ;
    dqv:expectedDataType xsd:decimal ;
    dqv:inDimension whis:dimension-linkability .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#address-link-coverage> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-address-link-coverage ;
    dqv:value 1.0000 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-built_year> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-completeness-built_year ;
    dqv:value 0.6333 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-built_year_or_period> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-completeness-built_year_or_period ;
    dqv:value 0.8333 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-irrigated_area_ha> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-completeness-irrigated_area_ha ;
    dqv:value 0.3333 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-lat> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-completeness-lat ;
    dqv:value 1.0000 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-managing_org> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-completeness-managing_org ;
    dqv:value 0.5833 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-name_en> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-completeness-name_en ;
    dqv:value 0.9833 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#elevation-agreement> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-elevation-agreement ;
    dqv:value 1.0000 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#link-health> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-link-health ;
    dqv:value 1.0000 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#source-coverage> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-source-coverage ;
    dqv:value 1.0000 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#wikidata-point-agreement> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-wikidata-point-agreement ;
    dqv:value 1.0000 .

<https://ysh17-hub.github.io/whis-lod/quality.ttl#wikidata-same-coverage> a dqv:QualityMeasurement ;
    dcterms:date "2026-11-25"^^xsd:date ;
    dqv:computedOn <https://ysh17-hub.github.io/whis-lod/dataset> ;
    dqv:isMeasurementOf whis:metric-wikidata-same-coverage ;
    dqv:value 0.4667 .

whis:dimension-linkability a dqv:Dimension ;
    skos:prefLabel "つながり"@ja .

whis:dimension-accuracy a dqv:Dimension ;
    skos:prefLabel "正確さ"@ja .

whis:dimension-completeness a dqv:Dimension ;
    skos:prefLabel "完全性"@ja .

<https://ysh17-hub.github.io/whis-lod/dataset> dqv:hasQualityMeasurement <https://ysh17-hub.github.io/whis-lod/quality.ttl#address-link-coverage>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-built_year>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-built_year_or_period>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-irrigated_area_ha>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-lat>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-managing_org>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#completeness-name_en>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#elevation-agreement>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#link-health>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#source-coverage>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#wikidata-point-agreement>,
        <https://ysh17-hub.github.io/whis-lod/quality.ttl#wikidata-same-coverage> .

